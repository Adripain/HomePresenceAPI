# This process must run on the same private network as the lighting bridge.
API_BASE_URL=https://api.example.com
# Use ENROLLMENT_CODE for the first start. The process prints a relay secret once.
ENROLLMENT_CODE=RLY_replace-me
# For later starts, remove ENROLLMENT_CODE and use the relay secret instead.
# RELAY_SECRET=rls_replace-me
RELAY_NAME=Home relay
