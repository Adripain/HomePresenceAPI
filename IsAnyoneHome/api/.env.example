# Never commit the real values. Generate each 32-byte value with:
# openssl rand -base64 32
POSTGRES_PASSWORD=replace-with-a-random-hex-value
SESSION_SIGNING_SECRET_BASE64=replace-with-32-random-bytes
DATA_ENCRYPTION_KEY_BASE64=replace-with-a-different-32-random-bytes
APPLE_CLIENT_ID=adriendtz.IsAnyoneHome
# Optional: required only to send remote presence notifications.
# Create an APNs key in Apple Developer, then run:
# base64 -w 0 AuthKey_XXXXXXXXXX.p8
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY_BASE64=
APNS_BUNDLE_ID=
