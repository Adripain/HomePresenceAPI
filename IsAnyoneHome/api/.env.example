# Never commit the real values. Generate each 32-byte value with:
# openssl rand -base64 32
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
DATABASE_URL=postgresql://presence:replace-me@127.0.0.1:5432/presence
DATABASE_SSL=false
SESSION_SIGNING_SECRET_BASE64=replace-with-32-random-bytes
DATA_ENCRYPTION_KEY_BASE64=replace-with-a-different-32-random-bytes
APPLE_CLIENT_ID=com.example.presence
# Set this only when the reverse proxy is on the same trusted private network.
TRUST_PROXY=false
